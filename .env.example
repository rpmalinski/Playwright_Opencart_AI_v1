# Environment variables for Playwright OpenCart AI project
# Copy this file to .env.local and add your values

# OpenRouter API key (for AI-powered testing)
OPENROUTER_API_KEY=

# 🌍 ENVIRONMENT
APP_ENV=qa # qa | prod | dev
### 🌐 WEB APP CONFIGURATION ###
# 🔗 WEB APP URL
WEB_APP_URL=https://awesomeqa.com/ui/
# 🔐 WEB APP LOGIN CREDENTIALS (CREATE YOUR OWN CREDENTIALS)
APP_EMAIL=pavanol@xyz.com
APP_PASSWORD="test@123"
# 🛒 PRODUCT DETAILS
PRODUCT_NAME=MacBook
PRODUCT_QUANTITY=1
TOTAL_PRICE=$602.00
### 🔌 API CONFIGURATION ###
# 🔗 API BASE URL
API_BASE_URL=
# 👤 API USER DETAILS
USERNAME=
PASSWORD=
USER_ID=
# 🛍 API PRODUCT DETAILS
PRODUCT_ID=
CART_ID=
LIMIT=
# 📅 DATE RANGE
START_DATE=
END_DATE=
#🔑 BASIC AUTHENTICATION CREDENTIALS (IF REQUIRED)
#BASIC_AUTH_USERNAME=YOUR_USERNAME
#BASIC_AUTH_PASSWORD=YOUR_PASSWORD
# 🔐 API KEY (IF REQUIRED)
#API_KEY=YOUR_API_KEY
# 🎟 ACCESS TOKEN (IF REQUIRED)
#ACCESS_TOKEN=YOUR_PERSONAL_ACCESS_TOKEN
# 🔄 OAUTH2 CONFIGURATION (IF REQUIRED)
#CLIENT_ID=YOUR_CLIENT_ID
#CLIENT_SECRET=YOUR_CLIENT_SECRET
#AUTHORIZATION_CODE=YOUR_AUTHORIZATION_CODE
#TOKEN_URL=YOUR_TOKEN_URL
### 🗄 DATABASE CONFIGURATION ###
# 🖥 DATABASE CONNECTION
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=
DB_SOCKET=
# 👨‍💼 ADMIN APP LOGIN CREDENTIALS
ADMIN_APP_URL=
ADMIN_USERNAME=
ADMIN_PASSWORD=